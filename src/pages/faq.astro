---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InspirationPhoto from '../components/InspirationPhoto.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Cabinet Painting FAQ"
  description="Answers to common questions about kitchen cabinet repainting in Gulf Shores: timing, paint, cost, oak grain, humidity and condo work."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <PageHero
    eyebrow="FAQ"
    title="Questions we hear at every estimate"
    lede="Timing, paint, price, oak grain and beach humidity, answered plainly."
  />

  <section class="section wrap faq-layout">
    <div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="more">Have a question that is not here? <a href="/contact/">Send it to us.</a></p>
    </div>
    <aside class="faq-aside">
      <InspirationPhoto />
    </aside>
  </section>

  <CtaBand />
</Base>

<style>
  .faq { max-width: 50rem; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer;
    padding: 1.25rem 2.5rem 1.25rem 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    list-style: none;
    position: relative;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+';
    position: absolute;
    right: 0.5rem;
    top: 1.1rem;
    font-family: var(--font-ui);
    font-size: 1.4rem;
    color: var(--blue);
  }
  details[open] summary::after { content: '−'; }
  details p { padding-bottom: 1.25rem; color: var(--muted); max-width: 65ch; }
  .more { margin-top: 2rem; }
  .faq-layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .faq-aside { position: sticky; top: 6rem; }
  @media (max-width: 860px) {
    .faq-layout { grid-template-columns: 1fr; }
    .faq-aside { position: static; }
  }
</style>
