---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';
---
<Base
  title="Cabinet Painting Services"
  description="Kitchen cabinet repainting, bathroom vanities, contrast islands, hardware updates and condo turnovers in Gulf Shores and south Baldwin County."
>
  <header class="wrap page-head">
    <p class="eyebrow">Services</p>
    <h1>Cabinet painting, done the slow way where it counts</h1>
    <p class="lede">Most of the work is prep. That is what keeps a finish from chipping at the edges in a year.</p>
  </header>

  <section class="section wrap">
    <div class="grid-3">
      {services.map((s) => (
        <article class="card">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band section">
    <div class="wrap grid-2">
      <div class="stack">
        <p class="eyebrow">Included with every job</p>
        <h2>What you get on every kitchen</h2>
      </div>
      <ul class="check-list">
        <li>Floors, counters, backsplash and appliances fully masked</li>
        <li>Doors and drawer fronts labeled and sprayed off-site</li>
        <li>Degreasing and scuff sanding on every surface we paint</li>
        <li>Bonding or stain-blocking primer matched to your wood</li>
        <li>Two finish coats of cabinet-grade enamel</li>
        <li>Hinges adjusted after reinstall so doors line up</li>
        <li>Final walkthrough and touch-ups with you</li>
        <li>Leftover paint labeled with the color and sheen for future touch-ups</li>
      </ul>
    </div>
  </section>

  <section class="section wrap grid-2">
    <div class="stack">
      <p class="eyebrow">Optional add-ons</p>
      <h2>Upgrades people ask for</h2>
    </div>
    <dl class="addons">
      <div><dt>Oak grain filling</dt><dd>Fills the open grain on oak for a smooth, modern surface.</dd></div>
      <div><dt>New hardware</dt><dd>Fill old holes, drill new ones with a jig so every pull lines up.</dd></div>
      <div><dt>Soft-close hinges</dt><dd>Swap old hinges for soft-close while the doors are off.</dd></div>
      <div><dt>Crown and light rail</dt><dd>Add trim at the top or bottom of uppers for a finished look.</dd></div>
      <div><dt>Interior shelves</dt><dd>Paint cabinet interiors and shelves to match.</dd></div>
    </dl>
  </section>

  <CtaBand />
</Base>

<style>
  .addons { margin: 0; display: grid; gap: 0; }
  .addons div { padding-block: 1rem; border-bottom: 1px solid var(--line); display: grid; gap: 0.25rem; }
  .addons div:first-child { padding-top: 0; }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--muted); }
</style>
