---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InspirationPhoto from '../components/InspirationPhoto.astro';
import { business, areas, otherAreas } from '../data/site';
const towns = [...areas.map((a) => a.name), ...otherAreas, 'Other'];
---
<Base
  title="Free Estimate"
  description="Book a free in-home estimate for kitchen cabinet repainting in Gulf Shores, Orange Beach, Foley, Fairhope and nearby."
>
  <PageHero
    eyebrow="Contact"
    title="Book a free estimate"
    lede="Tell us a little about your kitchen. We will reply within one business day to set up a visit."
    primary={{ href: '#estimate', label: 'Start my request' }}
  />

  <section class="wrap">
    <p class="sent card" id="sent" role="status" hidden>Thanks, we got your request. We will be in touch within one business day.</p>
    <p class="sent card error" id="send-error" role="alert" hidden>Your request did not go through. Please call us at the number on this page.</p>
  </section>

  <section class="section wrap layout">
    <!-- Handled by the Netlify Function in netlify/functions/estimate.mts -->
    <form class="card form" id="estimate" name="estimate" method="POST" action="/api/estimate">
      <p class="hp"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>

      <div class="row">
        <label for="name">Name</label>
        <input id="name" name="name" autocomplete="name" required />
      </div>
      <div class="row two">
        <div class="row">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" required />
        </div>
        <div class="row">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" />
        </div>
      </div>
      <div class="row two">
        <div class="row">
          <label for="town">Town</label>
          <select id="town" name="town" required>
            <option value="">Choose one</option>
            {towns.map((t) => <option>{t}</option>)}
          </select>
        </div>
        <div class="row">
          <label for="project">Project</label>
          <select id="project" name="project">
            <option>Kitchen cabinets</option>
            <option>Kitchen and vanities</option>
            <option>Bathroom vanities only</option>
            <option>Island only</option>
            <option>Condo or rental</option>
            <option>Something else</option>
          </select>
        </div>
      </div>
      <div class="row">
        <label for="message">About your cabinets <span class="opt">(optional)</span></label>
        <textarea id="message" name="message" rows="5" placeholder="Current finish, rough number of doors, colors you are considering, timing"></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Request my estimate</button>
    </form>

    <aside class="stack-lg">
      <div class="stack">
        <h2 class="h3">Call or text</h2>
        <p><a class="big" href={business.phoneHref}>{business.phone}</a></p>
        <p class="muted">{business.hours}</p>
      </div>
      <div class="stack">
        <h2 class="h3">What happens next</h2>
        <ol class="next">
          <li>We call to set a time that works for you.</li>
          <li>We visit, measure and look at your cabinets. About 30 minutes.</li>
          <li>You get a written price and a proposed start date.</li>
        </ol>
      </div>
      <InspirationPhoto caption="Bring photos of kitchens you like to the estimate. We will help you match the colors." />
    </aside>
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const sent = document.getElementById('sent');
  const sendError = document.getElementById('send-error');
  if (params.has('sent') && sent) sent.hidden = false;
  if (params.has('error') && sendError) sendError.hidden = false;
</script>

<style>
  .sent { margin-top: 1.5rem; border-color: var(--blue); font-weight: 600; }
  .sent.error { border-color: #b3412e; }
  [hidden] { display: none !important; }
  .layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .form { gap: 1.1rem; padding: clamp(1.25rem, 3vw, 2rem); }
  .row { display: grid; gap: 0.35rem; }
  .row.two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 1.1rem; }
  label { font-family: var(--font-ui); font-weight: 600; font-size: var(--step--1); }
  .opt { font-weight: 400; color: var(--muted); }
  input, select, textarea {
    font: inherit;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    width: 100%;
  }
  .btn { justify-self: start; }
  .hp { position: absolute; left: -9999px; }
  .h3 { font-size: var(--step-1); }
  .big { font-family: var(--font-display); font-size: var(--step-2); text-decoration: none; }
  .muted { color: var(--muted); }
  .next { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.5rem; color: var(--muted); }
  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }
</style>
