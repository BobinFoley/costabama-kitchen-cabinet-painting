---
import Base from '../layouts/Base.astro';
import ShakerDoor from '../components/ShakerDoor.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, services, process, areas, otherAreas, colors } from '../data/site';

const heroColors = colors.filter((c) => ['Coastal Blue', 'Driftwood Beige', 'Seafoam', 'Crisp Coastal White', 'Gulf Navy'].includes(c.name));
---
<Base
  title="Home"
  description="Kitchen cabinet repainting in Gulf Shores, Orange Beach, Foley and Fairhope. Sprayed, cabinet-grade finishes in about five working days. Free in-home estimates."
>
  <section class="hero wrap">
    <div class="hero-copy stack-lg">
      <p class="eyebrow">Gulf Shores · Orange Beach · Foley · Fairhope</p>
      <h1>New-looking cabinets in about five working days.</h1>
      <p class="lede">
        We repaint kitchen cabinets across south Baldwin County. Doors are sprayed in our shop, frames are finished in place, and you keep your counters, plumbing and layout.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/contact/">Book a free estimate</a>
        <a class="btn btn-ghost" href="/process/">See the 5-day process</a>
      </div>
      <ul class="check-list">
        <li>Cabinet-grade enamels, not wall paint</li>
        <li>Written schedule and fixed price before we start</li>
        <li>Kitchen stays usable in the evenings</li>
      </ul>
    </div>

    <div class="hero-visual">
      <div class="door-wrap" id="hero-door">
        <ShakerDoor color={heroColors[0].hex} label="Cabinet door preview" />
      </div>
      <div class="picker" role="group" aria-label="Try a cabinet color">
        {heroColors.map((c, i) => (
          <button
            type="button"
            class="swatch"
            style={`background:${c.hex}`}
            data-hex={c.hex}
            data-name={c.name}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={c.name}
          ></button>
        ))}
      </div>
      <p class="picker-label" aria-live="polite"><span id="color-name">{heroColors[0].name}</span> <span class="mono" id="color-hex">{heroColors[0].hex}</span></p>
    </div>
  </section>

  <section class="band section">
    <div class="wrap stack-lg">
      <div class="stack">
        <p class="eyebrow">How a week goes</p>
        <h2>Five days, start to walkthrough</h2>
      </div>
      <ol class="timeline">
        {process.map((step) => (
          <li>
            <span class="mono day">{step.day}</span>
            <h3>{step.title}</h3>
          </li>
        ))}
      </ol>
      <p><a class="on-band" href="/process/">What happens each day →</a></p>
    </div>
  </section>

  <section class="section wrap stack-lg">
    <div class="stack">
      <p class="eyebrow">Services</p>
      <h2>More than kitchens</h2>
    </div>
    <div class="grid-3">
      {services.slice(0, 3).map((s) => (
        <article class="card">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
    <p><a href="/services/">All services →</a></p>
  </section>

  <section class="section-tight wrap">
    <div class="compare">
      <div class="stack">
        <p class="eyebrow">Repaint or replace?</p>
        <h2>If the boxes are solid, paint them.</h2>
        <p class="lede">New cabinets mean demolition, new countertops in many cases, and weeks without a kitchen. Repainting keeps what works and changes what you see.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col"></th><th scope="col">Repaint</th><th scope="col">Replace</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Typical time</th><td>About 5 working days</td><td>Several weeks</td></tr>
            <tr><th scope="row">Countertops</th><td>Stay in place</td><td>Often removed or replaced</td></tr>
            <tr><th scope="row">Plumbing & appliances</th><td>Stay connected</td><td>Disconnected</td></tr>
            <tr><th scope="row">Debris</th><td>Minimal</td><td>A full dumpster</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section wrap stack-lg">
    <div class="stack">
      <p class="eyebrow">Service areas</p>
      <h2>Based in {business.city}, working across south Baldwin County</h2>
    </div>
    <div class="grid-2 areas">
      {areas.map((a) => (
        <a class="card area-card" href={`/service-areas/${a.slug}/`}>
          <h3>{a.name}</h3>
          <p>{a.blurb}</p>
        </a>
      ))}
    </div>
    <p class="muted">Also serving {otherAreas.join(', ')}.</p>
  </section>

  <CtaBand />
</Base>

<script>
  const door = document.querySelector<HTMLElement>('#hero-door svg');
  const nameEl = document.getElementById('color-name');
  const hexEl = document.getElementById('color-hex');
  document.querySelectorAll<HTMLButtonElement>('.swatch').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.swatch').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      door?.style.setProperty('--door', btn.dataset.hex ?? '');
      if (nameEl) nameEl.textContent = btn.dataset.name ?? '';
      if (hexEl) hexEl.textContent = btn.dataset.hex ?? '';
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }
  .hero-visual { display: grid; gap: 1rem; justify-items: center; }
  .door-wrap {
    width: min(100%, 17rem);
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.18));
  }
  .picker { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center; }
  .swatch {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 4px;
    border: 2px solid var(--line);
    cursor: pointer;
  }
  .swatch[aria-pressed='true'] { outline: 3px solid var(--ink); outline-offset: 2px; }
  .picker-label { font-weight: 600; }
  .mono { font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); font-weight: 500; }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 2px solid var(--band-accent);
  }
  .timeline li { padding: 1rem 1rem 0 0; display: grid; gap: 0.4rem; position: relative; }
  .timeline li::before {
    content: '';
    position: absolute;
    top: -7px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--band-accent);
  }
  .timeline .day { color: var(--band-accent); }
  .on-band { color: var(--band-ink); }

  .compare { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 2rem; align-items: center; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  th, td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--line); }
  thead th { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  tbody th { font-weight: 600; }
  td:nth-child(2) { color: var(--blue); font-weight: 600; }

  .areas { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1.5rem; }
  .area-card { text-decoration: none; color: var(--ink); transition: border-color 0.2s; }
  .area-card:hover { border-color: var(--blue); }
  .muted { color: var(--muted); }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .timeline { grid-template-columns: 1fr; border-top: 0; border-left: 2px solid var(--band-accent); }
    .timeline li { padding: 0 0 1.25rem 1.25rem; }
    .timeline li::before { top: 0.35rem; left: -7px; }
  }
</style>
