---
import Base from '../layouts/Base.astro';
import ShakerDoor from '../components/ShakerDoor.astro';
import CtaBand from '../components/CtaBand.astro';
import { colors, palettes } from '../data/site';
const hexOf = (name: string) => colors.find((c) => c.name === name)?.hex ?? '#cccccc';
---
<Base
  title="Cabinet Color Ideas for Coastal Kitchens"
  description="Coastal cabinet colors for Gulf Shores kitchens, including Coastal Blue with Driftwood Beige and Seafoam with Crisp White, plus Sherwin-Williams and Benjamin Moore matches."
>
  <header class="wrap page-head">
    <p class="eyebrow">Colors</p>
    <h1>Cabinet colors that work on the coast</h1>
    <p class="lede">Bright Gulf light washes out pale colors and makes some whites look cold. These are the directions our clients pick most often. We bring real paint samples to your estimate and paint a sample board in your kitchen's light.</p>
  </header>

  <section class="section-tight wrap stack-lg">
    <div class="stack">
      <p class="eyebrow">Signature palettes</p>
      <h2>Two-tone kitchens for the coast</h2>
      <p class="lede">Our most requested look: lighter uppers with colored lowers and island.</p>
    </div>
    <div class="grid-2">
      {palettes.map((pal) => (
        <article class="card palette">
          <div class="pair" aria-hidden="true">
            <div class="pair-door"><ShakerDoor color={hexOf(pal.upper)} label="" /></div>
            <div class="pair-door"><ShakerDoor color={hexOf(pal.lower)} label="" /></div>
          </div>
          <h3>{pal.name}</h3>
          <p>{pal.body}</p>
          <dl class="roles">
            <div><dt>Uppers</dt><dd>{pal.upper}</dd></div>
            <div><dt>Lowers &amp; island</dt><dd>{pal.lower}</dd></div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap stack-lg">
    <div class="stack">
      <p class="eyebrow">Colors and paint matches</p>
      <h2>Pick a starting point</h2>
    </div>
    <ul class="swatches">
      {colors.map((c) => (
        <li class="chip">
          <div class="chip-door"><ShakerDoor color={c.hex} label={`${c.name} cabinet door`} /></div>
          <div class="chip-body">
            <h2>{c.name}</h2>
            <p>{c.note}</p>
            {c.matches && (
              <p class="matches"><span class="label">Paint matches</span>{c.matches.join(' · ')}</p>
            )}
            <span class="mono">{c.hex}</span>
          </div>
        </li>
      ))}
    </ul>
    <p class="note">Screen colors are approximate. SW is Sherwin-Williams and BM is Benjamin Moore. Your final color is chosen from real paint chips and a sample board in your kitchen, and we can match any brand.</p>
  </section>

  <section class="band section">
    <div class="wrap grid-2">
      <div class="stack">
        <p class="eyebrow">Sheen</p>
        <h2>Satin or semi-gloss?</h2>
      </div>
      <div class="stack">
        <p><strong>Satin</strong> is our default. It hides minor surface texture and looks closest to a factory finish.</p>
        <p><strong>Semi-gloss</strong> is a little easier to wipe and suits rentals and busy family kitchens, but it shows every dent and brush mark on older doors.</p>
        <p><strong>Matte</strong> cabinet finishes look great in photos, but we only recommend them on doors that will not see much handling.</p>
      </div>
    </div>
  </section>

  <CtaBand heading="See colors in your own kitchen" text="We bring sample chips and paint a test board so you can see the color under your lights before you commit." />
</Base>

<style>
  .swatches {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .chip {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .chip-door { padding: 1.5rem 3rem; background: var(--driftwood); }
  .chip-body { padding: 1rem 1.25rem 1.25rem; display: grid; gap: 0.4rem; align-content: start; }
  .chip-body h2 { font-size: var(--step-1); }
  .chip-body p { color: var(--muted); font-size: var(--step--1); }
  .mono { font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); }
  .palette .pair { display: flex; gap: 1rem; padding: 1.25rem; background: var(--driftwood); border-radius: 4px; justify-content: center; }
  .pair-door { width: min(7rem, 40%); }
  .roles { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; border-top: 1px solid var(--line); padding-top: 0.75rem; }
  .roles dt { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .roles dd { margin: 0; font-weight: 600; }
  .matches { display: grid; gap: 0.15rem; }
  .matches .label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); }
  .note { margin-top: 1.5rem; color: var(--muted); font-size: var(--step--1); max-width: 65ch; }
</style>
