---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import InspirationPhoto from '../../components/InspirationPhoto.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, areas, otherAreas } from '../../data/site';
---
<Base
  title="Service Areas"
  description="Coastal Bama repaints kitchen cabinets in Gulf Shores, Orange Beach, Foley, Fairhope, Fort Morgan, Daphne, Spanish Fort and across Baldwin County, Alabama."
>
  <PageHero
    eyebrow="Service areas"
    title="Gulf Shores and the surrounding coast"
    lede={`We are based in ${business.city} and work throughout south ${business.county}. If you are not sure whether we come to you, ask.`}
  />

  <section class="section wrap stack-lg">
    <div class="grid-2">
      {areas.map((a) => (
        <a class="card area" href={`/service-areas/${a.slug}/`}>
          <h2>{a.name}</h2>
          <p>{a.blurb}</p>
          <p class="drive">{a.drive}</p>
          <span class="more">Cabinet painting in {a.name} →</span>
        </a>
      ))}
    </div>

    <div class="grid-2 also">
      <div class="stack">
        <h2 class="h3">Also serving</h2>
        <ul class="chips">
          {otherAreas.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <InspirationPhoto caption="From Fort Morgan beach houses to Eastern Shore homes, bright two-tone kitchens are the most requested look." />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .area { text-decoration: none; color: var(--ink); }
  .area:hover { border-color: var(--blue); }
  .area h2 { font-size: var(--step-2); }
  .drive { font-size: var(--step--1); }
  .more { color: var(--blue); font-weight: 600; }
  .h3 { font-size: var(--step-1); }
  .also { align-items: center; }
</style>
