---
// A shaker-style cabinet door drawn in SVG. Color comes from the --door CSS variable.
interface Props {
  color?: string;
  label?: string;
}
const { color = '#24384a', label = 'Shaker cabinet door' } = Astro.props;
---
<svg class="door" viewBox="0 0 200 300" role="img" aria-label={label} style={`--door:${color}`}>
  <rect x="2" y="2" width="196" height="296" rx="3" class="face" />
  <rect x="2" y="2" width="196" height="296" rx="3" class="edge" />
  <rect x="36" y="36" width="128" height="228" class="panel" />
  <rect x="36" y="36" width="128" height="228" class="panel-shade" />
  <line x1="36" y1="36" x2="164" y2="36" class="shadow" />
  <line x1="36" y1="36" x2="36" y2="264" class="shadow" />
  <line x1="36" y1="264" x2="164" y2="264" class="light" />
  <line x1="164" y1="36" x2="164" y2="264" class="light" />
  <rect x="168" y="118" width="8" height="64" rx="4" class="pull" />
</svg>

<style>
  .door { display: block; width: 100%; height: auto; }
  .face, .panel { fill: var(--door); transition: fill 0.35s ease; }
  .edge { fill: none; stroke: rgb(0 0 0 / 0.25); stroke-width: 2; }
  .panel-shade { fill: rgb(0 0 0 / 0.06); }
  .shadow { stroke: rgb(0 0 0 / 0.3); stroke-width: 3; }
  .light { stroke: rgb(255 255 255 / 0.35); stroke-width: 3; }
  .pull { fill: #c9b27c; stroke: rgb(0 0 0 / 0.3); stroke-width: 1; }
</style>
