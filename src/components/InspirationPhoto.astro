---
// The Seafoam & Crisp White design-inspiration kitchen, placed within page content.
interface Props {
  caption?: string;
}
const { caption = 'Seafoam lowers and island with crisp white uppers and white quartz.' } = Astro.props;
const slug = 'seafoam-crisp-white-kitchen';
const webp = [800, 1400].map((w) => `/images/${slug}-${w}.webp ${w}w`).join(', ');
// JPEG fallback for browsers and testing tools without WebP support.
const jpg = [800, 1400].map((w) => `/images/${slug}-${w}.jpg ${w}w`).join(', ');
const sizes = '(max-width: 820px) 100vw, 36rem';
---
<figure class="inspo">
  <picture>
  <source type="image/webp" srcset={webp} sizes={sizes} />
  <img
    src={`/images/${slug}-800.jpg`}
    srcset={jpg}
    sizes={sizes}
    width="2000"
    height="1116"
    alt="Beach house kitchen with crisp white upper cabinets, seafoam green lower cabinets and island, white quartz counters, and windows facing the dunes and Gulf."
    loading="lazy"
    decoding="async"
  />
  </picture>
  <figcaption>
    <span class="label"><span class="chips" aria-hidden="true"><i style="background:#f3f1ea"></i><i style="background:#a9c7ba"></i></span>Design inspiration</span>
    {caption}
  </figcaption>
</figure>

<style>
  .inspo { margin: 0; display: grid; gap: 0.6rem; }
  picture { display: contents; }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 2000 / 1116;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgb(31 47 59 / 0.12);
  }
  figcaption { font-size: var(--step--1); color: var(--muted); display: grid; gap: 0.2rem; }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .chips { display: inline-flex; flex-shrink: 0; }
  .chips i { width: 0.85rem; height: 0.85rem; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.12); }
  .chips i + i { margin-left: -0.3rem; }
</style>
