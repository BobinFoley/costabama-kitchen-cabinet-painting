---
import { business, nav } from '../data/site';
const path = Astro.url.pathname;
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${business.name} home`}>
      <span class="chip-stack" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="brand-text">
        <strong>Coastal Bama</strong>
        <small>Kitchen Cabinet Repainting</small>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="phone" href={business.phoneHref}><svg class="phone-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>{business.phone}</a>
      <a class="btn btn-primary" href="/contact/">Free Estimate</a>
    </nav>

    <div class="mobile-actions">
    <a class="phone phone-mobile" href={business.phoneHref} aria-label={`Call ${business.phone}`}><svg class="phone-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span>{business.phone}</span></a>
    <details class="nav-mobile">
      <summary aria-label="Menu"><svg class="burger" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg><span class="menu-label">Menu</span></summary>
      <nav aria-label="Mobile">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="btn btn-primary" href="/contact/">Free Estimate</a>
        <a href={business.phoneHref}>{business.phone}</a>
      </nav>
    </details>
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--blue);
    color: var(--blue-ink);
    padding: 0.5rem 1rem;
    z-index: 50;
  }
  .skip:focus { left: 1rem; }

  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-text { display: grid; line-height: 1.1; }
  .brand-text strong { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.01em; }
  .brand-text small { font-family: var(--font-ui); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

  .chip-stack { display: grid; grid-template-rows: repeat(3, 0.5rem); width: 1.6rem; border-radius: 3px; overflow: hidden; }
  .chip-stack i:nth-child(1) { background: #d8cebf; }
  .chip-stack i:nth-child(2) { background: #8fb0c7; }
  .chip-stack i:nth-child(3) { background: #3d6683; }

  .nav-desktop { display: flex; align-items: center; gap: 1.25rem; }
  .nav-desktop a.phone:not(.btn), .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--blue);
    text-decoration: none;
    white-space: nowrap;
  }
  .phone:hover { text-decoration: underline; }
  .phone-icon { width: 1rem; height: 1rem; fill: currentColor; flex-shrink: 0; }
  .mobile-actions { display: none; align-items: center; gap: 0.9rem; flex-shrink: 0; }
  .nav-mobile { flex-shrink: 0; }
  .brand-text strong { white-space: nowrap; }
  .burger { display: none; width: 1.3rem; height: 1.3rem; stroke: currentColor; stroke-width: 2; stroke-linecap: round; fill: none; }
  .nav-desktop a:not(.btn), .nav-mobile nav a:not(.btn) {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 500;
  }
  .nav-desktop a[aria-current='page']:not(.btn) { color: var(--blue); text-decoration: underline; text-decoration-thickness: 2px; }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    width: min(18rem, calc(100vw - 32px));
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem;
    display: grid;
    gap: 0.8rem;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.15);
  }

  @media (max-width: 1140px) {
    .nav-desktop { display: none; }
    .mobile-actions { display: flex; }
    .nav-mobile { display: block; }
  }
  /* Phones: keep the number visible; the menu button becomes an icon. */
  @media (max-width: 560px) {
    .bar { gap: 0.6rem; }
    .mobile-actions { gap: 0.6rem; }
    .phone-mobile { font-size: 0.92rem; }
    .menu-label { display: none; }
    .burger { display: block; }
    .nav-mobile summary { padding: 0.5rem 0.6rem; }
  }
  @media (max-width: 400px) {
    .brand { gap: 0.5rem; }
    .brand-text small { display: none; }
    .brand-text strong { font-size: 1.1rem; }
    .chip-stack { width: 1.2rem; }
    .phone-mobile { font-size: 0.85rem; gap: 0.3rem; }
  }
</style>
