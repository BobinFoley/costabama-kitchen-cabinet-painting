---
// Photo hero used at the top of every page: the Coastal Blue & Driftwood Beige
// design-inspiration kitchen with a light wash behind the page heading.
interface Link {
  href: string;
  label: string;
}
interface Props {
  title: string;
  eyebrow?: string;
  crumb?: Link; // optional link shown before the eyebrow, e.g. "Service areas /"
  lede?: string;
  size?: 'home' | 'page';
  primary?: Link | false;
  secondary?: Link;
}

const {
  title,
  eyebrow,
  crumb,
  lede,
  size = 'page',
  primary = { href: '/contact/', label: 'Book a free estimate' },
  secondary,
} = Astro.props;

const slug = 'coastal-blue-driftwood-kitchen';
const srcset = [800, 1400, 2000].map((w) => `/images/${slug}-${w}.webp ${w}w`).join(', ');
---
<section class:list={['hero', size]} aria-labelledby="page-title">
  <img
    class="photo"
    src={`/images/${slug}-1400.webp`}
    srcset={srcset}
    sizes="100vw"
    width="2000"
    height="1116"
    alt="Beach house kitchen with driftwood beige upper cabinets, dusty coastal blue lower cabinets and island, brass pulls, and a view of the Gulf through sliding doors."
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="wash" aria-hidden="true"></div>

  <div class="wrap content">
    <div class="copy">
      {(eyebrow || crumb) && (
        <p class="eyebrow">
          {crumb && <><a href={crumb.href}>{crumb.label}</a> / </>}
          {eyebrow}
        </p>
      )}
      <h1 id="page-title">{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      {(primary || secondary) && (
        <div class="btn-row">
          {primary && <a class="btn btn-primary" href={primary.href}>{primary.label}</a>}
          {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
        </div>
      )}
    </div>
    <p class="tag"><span class="chips" aria-hidden="true"><i style="background:#d8cebf"></i><i style="background:#8fb0c7"></i></span>Design inspiration: Coastal Blue &amp; Driftwood Beige</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    background: var(--band);
  }
  .hero.home { min-height: clamp(34rem, 72vh, 46rem); }
  .hero.page { min-height: clamp(24rem, 52vh, 32rem); }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 60% 50%;
  }
  .wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgb(251 250 247 / 0.95) 0%,
      rgb(251 250 247 / 0.88) 34%,
      rgb(251 250 247 / 0.35) 60%,
      rgb(251 250 247 / 0) 80%
    );
  }

  .content {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1.5rem;
    width: 100%;
    padding-block: clamp(2.5rem, 7vw, 5rem) 1.25rem;
  }
  .copy { display: grid; gap: 1.1rem; align-content: center; max-width: 36rem; }
  .eyebrow a { color: inherit; }
  .page h1 { font-size: var(--step-4); }
  .copy .lede { color: var(--ink); }

  .tag {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
    background: rgb(255 255 255 / 0.9);
    border-radius: 999px;
    padding: 0.4rem 0.9rem 0.4rem 0.5rem;
    box-shadow: 0 4px 14px rgb(31 47 59 / 0.12);
  }
  .chips { display: inline-flex; flex-shrink: 0; }
  .chips i { width: 1.05rem; height: 1.05rem; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.12); }
  .chips i + i { margin-left: -0.35rem; }

  /* Phones: photo on top, unobstructed; heading on the light band below it. */
  @media (max-width: 720px) {
    .hero.home, .hero.page { min-height: 0; display: block; }
    .photo { position: relative; inset: auto; z-index: 0; height: auto; aspect-ratio: 4 / 3; max-width: 100%; object-position: 62% 50%; }
    .wash { display: none; }
    .content { padding-block: 1.5rem 1.75rem; }
    .tag { justify-self: start; order: -1; font-size: 0.8rem; }
  }
</style>
